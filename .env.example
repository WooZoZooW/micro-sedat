# Copy to .env and fill in locally. Never commit the real .env file.
# All values below are placeholders. No real secrets belong in git.

# --- GitHub delivery destination (private inbox repository) ---
# Fine-grained PAT with "Contents: Read and write" on the inbox repo only.
GITHUB_TOKEN=github_pat_placeholder_replace_me
GITHUB_OWNER=WooZoZooW
GITHUB_REPO=micro-sedat-inbox
# "release" (recommended, raw binary uploads) or "contents" (base64 commits)
GITHUB_SUBMISSION_MODE=release

# Optional overrides, useful for tests and GitHub Enterprise proxies.
# GITHUB_API_BASE=https://api.github.com
# GITHUB_UPLOAD_BASE=https://uploads.github.com

# --- Access control ---
# Optional shared access code. When set, every submission must send it in the
# "X-Access-Code" header. Use a long random value. This is a lightweight gate,
# not full authentication.
ACCESS_CODE=

# Optional admin token for GET /api/submissions/:id. Send as
# "Authorization: Bearer <token>".
ADMIN_TOKEN=

# Comma-separated list of additional browser origins allowed to call the API,
# e.g. https://example.github.io. Same-origin requests are always allowed.
ALLOWED_ORIGINS=

# --- Local development server ---
PORT=8787
HOST=127.0.0.1

# --- Limits (bytes; defaults shown) ---
MAX_TOTAL_BYTES=20971520
MAX_FILE_BYTES=15728640
MAX_AUDIO_BYTES=15728640
MAX_FILES=12
MAX_TEXT_CHARS=4000

# --- Best-effort rate limiting ---
# Window in milliseconds and maximum submissions per window per client IP.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=12
